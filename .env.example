# ==============================================================================
# Master Admin Credentials (Hidden from GitHub)
# ==============================================================================
MASTER_EMAIL=admin@example.com
MASTER_PASS=your-secure-password
NEXT_PUBLIC_MASTER_EMAIL=admin@example.com
