rules_version = '2';

// Copy Cat: all shop data (inventory, settings, instapay, audit) is read and written only by the
// server with firebase-admin, which these rules don't apply to. The browser gets nothing, except the
// LAN-transfer signaling for a PC signed in with the custom token from /api/admin/lan-room.
service cloud.firestore {
  match /databases/{database}/documents {
    function lanMember(room) {
      return request.auth != null
        && request.auth.token.lan == true
        && request.auth.token.lanRoom == room;
    }

    match /lanRooms/{room}/peers/{peerId} {
      allow read, delete: if lanMember(room);
      allow create, update: if lanMember(room)
        && request.resource.data.keys().hasOnly(['name', 'seenAt', 'expireAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
    }

    match /lanRooms/{room}/signals/{signalId} {
      allow read, delete: if lanMember(room);
      allow create: if lanMember(room)
        && request.resource.data.keys().hasOnly(['to', 'from', 'fromName', 'sid', 'kind', 'data_json', 'meta', 'createdAt', 'expireAt'])
        && request.resource.data.kind in ['offer', 'answer', 'ice', 'cancel']
        && (request.resource.data.data_json == null || request.resource.data.data_json.size() <= 20000);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
